# ==============================================================================
# ClinicQ Environment Configuration
# ==============================================================================

APP_NAME="ClinicQ - Outpatient Appointment & Smart Queue System"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Database Configuration
# Local standalone SQLite (default for development without Docker):
DATABASE_URL="sqlite+aiosqlite:///./clinicq.db"

# Or PostgreSQL (production / Docker Compose):
# POSTGRES_SERVER=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=clinicq_user
# POSTGRES_PASSWORD=clinicq_password
# POSTGRES_DB=clinicq_db
# DATABASE_URL=postgresql+asyncpg://clinicq_user:clinicq_password@localhost:5432/clinicq_db

# JWT Security
SECRET_KEY="clinicq-ultra-secure-jwt-secret-key-32chars-minimum-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:5173","http://localhost:5174"]

# Background No-Show Sweep
NO_SHOW_CHECK_INTERVAL_MINUTES=60
NO_SHOW_CUTOFF_HOUR_UTC=20
